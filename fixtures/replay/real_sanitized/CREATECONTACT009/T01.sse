event: ACTIVITY_SNAPSHOT
data: {"type":"ACTIVITY_SNAPSHOT","messageId":"a2ui-thinking-step-90cb8828_4485236609080777","activityType":"a2ui-surface","content":{"operations":[{"surfaceUpdate":{"surfaceId":"thinking-step-90cb8828","components":[{"id":"thinking-step-90cb8828","component":{"ThinkingExecutionProcess":{"status":"pending","msg":"正在执行 CRM智能查询","processKey":"step-90cb8828","skillName":"crm_query","skillKey":"crm_query","defaultCollapsed":true,"actions":[],"toolCount":0,"children":{"explicitList":[]},"match_method":"semantic","match_basis":"当\"查到 CRM 数据\"就是用户这次想要的最终结果、可直接作为答案呈现给用户时用本技能。适用：\n- 用户直接要看某类 CRM 记录或其字段（客户、联系人、线索、商机、订单、合同、报价单、产品、活动记录、日程、自定义实体等）\n- 按条件筛选、搜索，或做查询引擎一次就能算出并直接展示的统计/对比（如\"本月新增客户数\"\"金额最大的商机\"\"对比两个客户的商机数\"）\n- 需要向用户呈现数据卡片的场景\n\n不要用本技能：当查到的数据只是你后续还要自己加工的中间材料时（如你要按自定义口径分层、自己做进一步分析研判、跨多次查询合并、或作为下一步查询的输入）——那种情况改用 query_CRM_data 工具，拿到记录后由你处理。\n（示例：用户说\"查询我的客户，然后做客户分层\"——\"查客户\"这一步用 query_CRM_data 工具，因为你还要接着做分层；不要用本技能。）\n","component_label":"CRM智能查询","match_level":"skill_level","exec_mode":"fork","output_mode":"stream","post_action":"summarize","label_key":"ai_skill_base_crm_query"}}}]}},{"beginRendering":{"surfaceId":"thinking-step-90cb8828","root":"thinking-step-90cb8828"}}]},"replace":true,"cmpMessageId":"4485236609080777"}

