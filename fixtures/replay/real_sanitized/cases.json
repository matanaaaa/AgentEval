    "metadata": {
      "scenario": "standard_create",
      "priority": "P0",
      "difficulty": "easy",
      "tags": ["field_extraction", "confirmation_flow", "reverse_description"]
    },
    "type": "confirmation",
    "turns": [
      {
        "turn_id": "T01",
        "input": "张伟经理，示例建工集团市场部，女，手机13800000001，邮箱zhangwei@example.com，办公电话80000001，默认业务类型，角色是审批者，帮我创建这个联系人",
        "expected": {
          "text_assertions": {
            "all": ["张伟"],
            "any": ["确认", "创建", "信息"]
          }
        }
      },
      {
        "turn_id": "T02",
        "input": "确认创建",
        "expected": {
          "text_assertions": {
            "any": ["创建成功", "已创建", "完成"]
          }
        }
      }
    ],
    "evaluation": {
      "skill": "extract-data",
      "tools_required": ["save_record"],
      "object_type": "contact",
      "business_success": true,
      "fields": {
        "contactName": "张伟",
        "gender": "女",
        "mobile": "13800000001",
        "email": "zhangwei@example.com",
        "phone": "80000001",
        "depart": "市场部",
        "post": "经理",
        "contactRole": "审批者",
        "entityType": "默认业务类型"
      }
    }
  },
  {
