[
  {
    "id": "CREATEACCOUNT027",
    "name": "录入客户：电话字段改写、非法格式与清空",
    "metadata": {
      "scenario": "phone_update_and_clear",
      "priority": "P1",
      "difficulty": "hard",
      "tags": ["account", "multi_turn", "field_update", "field_delete"]
    },
    "type": "multi_turn",
    "turns": [
      {
        "turn_id": "C01T01",
        "input": "新建客户，叫示例财富管理股份有限公司,电话13800000002",
        "expected": {
          "text_assertions": {
            "all": ["示例财富管理股份有限公司"],
            "any": ["电话", "13800000002"]
          }
        }
      },
      {
        "turn_id": "C01T02",
        "input": "电话改成abc123",
        "expected": {
          "text_assertions": {
            "any": ["格式", "不正确", "无效", "不合法", "有误"]
          }
        }
      },
      {
        "turn_id": "C01T03",
        "input": "电话先不填了，去掉",
        "expected": {
          "text_assertions": {
            "any": ["已清空", "已删除", "已去掉", "已移除", "电话"]
          },
          "state_assertion": {
            "fields": {
              "accountName": "示例财富管理股份有限公司"
            },
            "absent": ["phone"]
          }
        }
      }
    ],
    "evaluation": {
      "skill": "extract-data",
      "object_type": "account",
      "business_success": "pending",
      "field_constraints": {
        "accountName": "present",
        "phone": "absent"
      }
    }
  },
  {
    "id": "CREATECONTACT003",
