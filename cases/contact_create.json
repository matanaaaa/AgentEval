      {
        "turn_id": "C01T02",
        "input": "他叫孙鑫，男士，角色是权力支持者",
        "expected": {
          "text_assertions": {
            "all": ["孙鑫", "中铁十二局集团"]
          },
          "state_assertion": {
            "fields": {"contactName": "孙鑫", "gender": "男"}
          }
        }
      },
      {
        "turn_id": "C01T03",
        "input": "他的手机是13800138000，邮箱chenxin@tianke.com",
        "expected": {
          "text_assertions": {
            "all": ["孙鑫", "13800138000", "chenxin@tianke.com"]
          }
        }
      },
      {
        "turn_id": "C01T04",
        "input": "不对，他是技术部的vp，角色是决策者",
        "expected": {
          "text_assertions": {
            "all": ["孙鑫"],
            "iany": ["vp", "VP", "副总裁", "副总"]
          },
          "state_assertion": {
            "fields": {"post": "VP"}
          }
        }
      },
      {
        "turn_id": "C01T05",
        "input": "确认创建",
        "expected": {
          "text_assertions": {
            "any": ["创建成功", "已创建", "完成"]
          }
        }
      }
    ],
