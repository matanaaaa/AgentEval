  {
    "id": "CREATECONTACT006",
    "name": "录入联系人：多轮改写-更改已录入的信息",
    "metadata": {
      "scenario": "field_update",
      "priority": "P0",
      "difficulty": "hard",
      "tags": ["multi_turn", "context_memory", "field_update"]
    },
    "type": "multi_turn",
    "turns": [
      {
        "turn_id": "C01T01",
        "input": "给客户中铁十二局集团，创建联系人，是技术部总监，默认业务类型",
        "expected": {
          "text_assertions": {
            "all": ["中铁十二局集团", "技术部"],
            "any": ["请填写", "缺失", "必填", "补充", "姓名", "确认"]
